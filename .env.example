[TEMPLATE]
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Authentication & Database Config
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Authentication Mode (REQUIRED — explicit, fail-closed)
# "production" (or unset): Supabase authentication ONLY. Missing/broken Supabase
#   configuration FAILS CLOSED with a configuration error — no demo identity,
#   no fake session, no demo data. Browser state can never activate demo mode.
# "demo": enables the isolated localStorage demo experience (Alex Rivera demo
#   environment). ONLY set this on dedicated demo deployments.
NEXT_PUBLIC_AUTH_MODE=production

# NOTE: NEXT_PUBLIC_ENABLE_DEMO_FALLBACK was removed — it was never read by
# any code. Demo mode is controlled exclusively by NEXT_PUBLIC_AUTH_MODE.

# Supabase Service Role Key (Server-side Only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Brevo Transactional Email Config (Server-side Only)
BREVO_API_KEY=xkeysib-your_brevo_api_key
EMAIL_FROM="Flowdesk <your_verified_sender@example.com>"

# Razorpay Payment Gateway (Test Mode / Production)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# FlowDesk SaaS Subscription Billing Webhook (Separate from Client Invoice Webhooks)
RAZORPAY_BILLING_WEBHOOK_SECRET=your_razorpay_billing_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Upstash Redis Distributed Rate Limiter (Server-side Only)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Server-Boundary Mutation Feature Flags (Phase 5)
# Controls progressive migration of write mutations from direct browser Supabase
# calls to secure server route handlers (app/api/*). Defaults to ON (true) in code.
# Set to "false" to temporarily roll back a batch to legacy client services if needed.
NEXT_PUBLIC_SERVER_MUTATIONS_BATCH_1=true
NEXT_PUBLIC_SERVER_MUTATIONS_BATCH_2=true
NEXT_PUBLIC_SERVER_MUTATIONS_BATCH_3=true
NEXT_PUBLIC_SERVER_MUTATIONS_BATCH_4=true


