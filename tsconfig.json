{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/frontend/*": ["./src/frontend/*"],
      "@/backend/*": ["./src/backend/*"],
      "@/database/*": ["./database/*"],
      "@/shared/*": ["./src/shared/*"],
      "@/features/*": ["./src/frontend/*"],
      "@/components/*": ["./src/frontend/shared/*"],
      "@/services/*": ["./src/backend/*"],
      "@/repositories/*": ["./src/backend/repositories/*"],
      "@/utils/*": ["./src/shared/utils/*"],
      "@/types": ["./src/shared/types/index.ts"],
      "@/types/*": ["./src/shared/types/*"],
      "@/mock/*": ["./src/backend/store/*"],
      "@/hooks/*": ["./src/frontend/shared/hooks/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts"
  ]
}
